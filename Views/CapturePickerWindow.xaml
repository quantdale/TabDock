<Window x:Class="TabDock.Views.CapturePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Capture windows — TabDock"
        Height="620"
        Width="700"
        MinWidth="520"
        MinHeight="420"
        MaxWidth="{x:Static SystemParameters.MaximizedPrimaryScreenWidth}"
        MaxHeight="{x:Static SystemParameters.MaximizedPrimaryScreenHeight}"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource TdWindowBackgroundBrush}"
        Foreground="{StaticResource TdTextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Capture windows" FontSize="22" FontWeight="SemiBold"
                           Foreground="{StaticResource TdTextBrush}" />
                <TextBlock Text="Choose the apps that belong together. Your selection survives refreshes while those windows still exist."
                           Foreground="{StaticResource TdTextMutedBrush}" FontSize="11"
                           TextWrapping="Wrap" Margin="0,5,16,0" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource TdSecondaryButton}"
                    Content="Refresh" Padding="12,6" MinHeight="34"
                    Command="{Binding RefreshCommand}"
                    AutomationProperties.AutomationId="CaptureRefresh"
                    AutomationProperties.Name="Refresh capturable windows" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="260" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Style="{StaticResource TdSectionLabel}" Text="SEARCH WINDOWS" Margin="1,0,0,6" />
                <TextBox Style="{StaticResource TdTextBox}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Search capturable windows"
                         ToolTip="Filter by window title, executable path, or window class" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Style="{StaticResource TdSectionLabel}" Text="DESTINATION" Margin="1,0,0,6" />
                <ComboBox Style="{StaticResource TdComboBox}"
                          ItemsSource="{Binding Groups}"
                          SelectedItem="{Binding SelectedGroupOption}"
                          AutomationProperties.Name="Destination group" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding SelectionSummary}"
                       Foreground="{StaticResource TdTextMutedBrush}" FontSize="11"
                       VerticalAlignment="Center"
                       AutomationProperties.AutomationId="CaptureSelectionSummary" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource TdGhostButton}"
                        Content="Select all visible" Padding="9,4" MinHeight="28"
                        Command="{Binding SelectAllVisibleCommand}"
                        AutomationProperties.Name="Select all visible windows" />
                <Button Style="{StaticResource TdGhostButton}"
                        Content="Clear" Padding="9,4" MinHeight="28" Margin="4,0,0,0"
                        Command="{Binding ClearSelectionCommand}"
                        AutomationProperties.Name="Clear window selection" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="3" Background="{StaticResource TdSurfaceBrush}"
                BorderBrush="{StaticResource TdBorderBrush}" BorderThickness="1"
                CornerRadius="10" Padding="8">
            <Grid>
                <ListBox x:Name="WindowsListBox"
                         ItemsSource="{Binding FilteredWindows}"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,4" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10,9" CornerRadius="7" Background="#0F151E"
                                    BorderBrush="#1E2A38" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              VerticalAlignment="Center" Margin="1,0,11,0"
                                              AutomationProperties.Name="Select window" />
                                    <Border Grid.Column="1" Width="34" Height="34" CornerRadius="7"
                                            Background="#17202C" Margin="0,0,10,0">
                                        <Image Source="{Binding Icon}" Width="20" Height="20"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource TdTextBrush}"
                                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding ExePath}" Foreground="{StaticResource TdTextSubtleBrush}"
                                                   FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            MaxWidth="360" IsHitTestVisible="False">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasFilteredWindows}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="No matches" Foreground="{StaticResource TdTextBrush}"
                               FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding EmptyFilterText}" Foreground="{StaticResource TdTextMutedBrush}"
                               FontSize="11" TextAlignment="Center" TextWrapping="Wrap" Margin="0,5,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="{Binding CaptureAdmissionReason}"
                       Foreground="{StaticResource TdWarningBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,9"
                       AutomationProperties.AutomationId="CaptureAdmissionStatus">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CaptureAdmissionBlocked}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="Tip: type part of an app name to narrow long desktop lists."
                           Foreground="{StaticResource TdTextSubtleBrush}" FontSize="10"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource TdPrimaryButton}"
                            Content="Group selected" MinWidth="124" IsDefault="True"
                            Command="{Binding GroupSelectedCommand}"
                            IsEnabled="{Binding CaptureAllowed}"
                            AutomationProperties.AutomationId="CaptureGroupThese"
                            AutomationProperties.Name="Group selected windows"
                            AutomationProperties.HelpText="{Binding CaptureAdmissionReason}" />
                    <Button Style="{StaticResource TdSecondaryButton}"
                            Content="Cancel" MinWidth="82" Margin="9,0,0,0" IsCancel="True"
                            Command="{Binding CancelCommand}"
                            AutomationProperties.AutomationId="CaptureCancel" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>