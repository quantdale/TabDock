<Window x:Class="TabDock.Views.ContainerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:infra="clr-namespace:TabDock.Infrastructure"
        xmlns:vm="clr-namespace:TabDock.ViewModels"
        mc:Ignorable="d"
        Title="{Binding Name}"
        Height="600"
        Width="900"
        MinWidth="320"
        MinHeight="240"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{Binding AccentBrush}"
        Name="Root">

    <Window.Resources>
        <Style TargetType="Button" x:Key="CaptionButtonStyle">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="32" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        </Style>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="6"
                      CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom caption -->
        <Grid Height="32" Background="{Binding AccentBrush}" Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Accent color chip / color picker -->
            <Button Grid.Column="0" Width="16" Height="16" Margin="12,0,8,0"
                    Background="{Binding AccentBrush}" BorderBrush="White" BorderThickness="1"
                    WindowChrome.IsHitTestVisibleInChrome="True"
                    ToolTip="Change accent color" Click="ColorChip_Click">
                <Button.ContextMenu>
                    <ContextMenu x:Name="ColorContextMenu">
                        <MenuItem Header="Blue" Click="ColorMenuItem_Click" Tag="#2196F3" />
                        <MenuItem Header="Green" Click="ColorMenuItem_Click" Tag="#4CAF50" />
                        <MenuItem Header="Red" Click="ColorMenuItem_Click" Tag="#F44336" />
                        <MenuItem Header="Purple" Click="ColorMenuItem_Click" Tag="#9C27B0" />
                        <MenuItem Header="Orange" Click="ColorMenuItem_Click" Tag="#FF9800" />
                        <MenuItem Header="Teal" Click="ColorMenuItem_Click" Tag="#009688" />
                        <MenuItem Header="Pink" Click="ColorMenuItem_Click" Tag="#E91E63" />
                        <MenuItem Header="Gray" Click="ColorMenuItem_Click" Tag="#607D8B" />
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>

            <!-- IsHitTestVisibleInChrome is required on every interactive caption
                 element: the WindowChrome CaptionHeight region otherwise consumes
                 all clicks as non-client hits (a title double-click maximized the
                 window instead of starting a rename). -->
            <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                       Foreground="White" FontSize="12" FontWeight="SemiBold"
                       WindowChrome.IsHitTestVisibleInChrome="True"
                       MouseLeftButtonDown="TitleText_MouseLeftButtonDown">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Visibility is driven entirely by the style Setter + IsRenaming
                 DataTrigger below. Do NOT set Visibility as a local attribute here:
                 a local value outranks style/trigger setters, so the trigger could
                 never show the box (the box stayed collapsed forever). -->
            <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=LostFocus}"
                     VerticalAlignment="Center" BorderThickness="0" Background="White"
                     Foreground="Black" Padding="4,2"
                     WindowChrome.IsHitTestVisibleInChrome="True"
                     x:Name="RenameBox"
                     LostFocus="RenameBox_LostFocus"
                     KeyDown="RenameBox_KeyDown">
                <TextBox.Style>
                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>

            <Button Grid.Column="2" Content="Group ▾" Width="82" Height="24"
                    HorizontalAlignment="Left" Margin="8,0,0,0"
                    Background="Transparent" Foreground="White" BorderThickness="0"
                    WindowChrome.IsHitTestVisibleInChrome="True"
                    AutomationProperties.AutomationId="GroupSelector"
                    Click="GroupButton_Click" ToolTip="Switch group or create a group">
                <Button.ContextMenu>
                    <ContextMenu x:Name="GroupContextMenu" Closed="GroupContextMenu_Closed" />
                </Button.ContextMenu>
            </Button>

            <!-- Add window to group -->
            <Button Grid.Column="3" Style="{StaticResource CaptionButtonStyle}"
                    Content="&#xE710;" Click="AddWindow_Click" ToolTip="Add window to group"
                    AutomationProperties.AutomationId="AddWindowButton" />

            <Button Grid.Column="4" Style="{StaticResource CaptionButtonStyle}"
                    Content="&#xE949;" Click="Minimize_Click" ToolTip="Minimize" />
            <Button Grid.Column="5" Style="{StaticResource CaptionButtonStyle}"
                    Content="&#xE739;" Click="Maximize_Click" ToolTip="Maximize" x:Name="MaximizeButton" />
            <Button Grid.Column="6" Style="{StaticResource CaptionButtonStyle}"
                    Content="&#xE106;" Click="Close_Click" ToolTip="Close" />
        </Grid>

        <!-- Tab strip -->
        <Border Grid.Row="1" Background="#22000000" Height="32">
            <ListBox x:Name="TabsListBox"
                     ItemsSource="{Binding DisplayTabs}"
                     SelectedItem="{Binding ActiveTab, Mode=OneWay}"
                     SelectionChanged="TabsListBox_SelectionChanged"
                     PreviewMouseRightButtonDown="TabsListBox_PreviewMouseRightButtonDown"
                     Background="Transparent"
                     BorderThickness="0"
                     Focusable="False"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="2,2,0,2" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="IsSelected" Value="{Binding IsActive, Mode=TwoWay}" />
                        <Setter Property="AutomationProperties.AutomationId" Value="{Binding AutomationId}" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.Resources>
                    <!-- Ordinary single tab. -->
                    <DataTemplate DataType="{x:Type vm:TabViewModel}">
                        <Border Padding="8,4" CornerRadius="4">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                            <Setter Property="Background" Value="#44FFFFFF" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding Title}" Foreground="White" VerticalAlignment="Center" MaxWidth="160" TextTrimming="CharacterEllipsis" />
                                <Button Content="×" Width="20" Height="20" Margin="6,-1,0,0"
                                        Padding="0" Background="Transparent" Foreground="#CCFFFFFF"
                                        BorderThickness="0" FontSize="14" ToolTip="Pop out"
                                        AutomationProperties.AutomationId="TabClose"
                                        PreviewMouseLeftButtonDown="TabClose_PreviewMouseLeftButtonDown"
                                        WindowChrome.IsHitTestVisibleInChrome="True" />
                            </StackPanel>
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Pop out" Command="{Binding PopOutCommand}" />
                                    <MenuItem Header="Close window" Command="{Binding CloseWindowCommand}" />
                                </ContextMenu>
                            </Border.ContextMenu>
                        </Border>
                    </DataTemplate>

                    <!-- Split pair: ONE visual tab item [ A | B ] with a subtle
                         central separator, so the strip communicates "LEFT pane +
                         RIGHT pane" instead of two unrelated tabs. Each half is
                         independently interactive (click focuses that member
                         without hiding the partner; × / middle-click / right-click
                         target that specific member). Right-click menus are built
                         in code (TabsListBox_PreviewMouseRightButtonDown) so they
                         carry the split-aware items, so no ContextMenu is declared
                         on the halves here. -->
                    <DataTemplate DataType="{x:Type vm:SplitCompositeViewModel}">
                        <Border Padding="6,4" CornerRadius="4"
                                AutomationProperties.AutomationId="SplitCompositeItem">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- LEFT half -->
                                <Border Grid.Column="0" Tag="LEFT" Margin="0,0,3,0"
                                        AutomationProperties.AutomationId="SplitHalfLeft"
                                        PreviewMouseLeftButtonDown="SplitHalf_PreviewMouseLeftButtonDown"
                                        PreviewMouseDown="SplitHalf_PreviewMouseDown">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Left.IsActive}" Value="True">
                                                    <Setter Property="Background" Value="#44FFFFFF" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{Binding Left.Icon}" Width="16" Height="16" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding Left.Title}" Foreground="White" VerticalAlignment="Center" MaxWidth="120" TextTrimming="CharacterEllipsis" />
                                        <Button Content="×" Tag="LEFT" Width="18" Height="18" Margin="6,-1,0,0"
                                                Padding="0" Background="Transparent" Foreground="#CCFFFFFF"
                                                BorderThickness="0" FontSize="14" ToolTip="Pop out left window"
                                                AutomationProperties.AutomationId="SplitCloseLeft"
                                                PreviewMouseLeftButtonDown="SplitHalfClose_PreviewMouseLeftButtonDown"
                                                WindowChrome.IsHitTestVisibleInChrome="True" />
                                    </StackPanel>
                                </Border>

                                <!-- Central separator -->
                                <Border Grid.Column="1" Width="1" Background="#66FFFFFF" Margin="0,3" />

                                <!-- RIGHT half -->
                                <Border Grid.Column="2" Tag="RIGHT" Margin="3,0,0,0"
                                        AutomationProperties.AutomationId="SplitHalfRight"
                                        PreviewMouseLeftButtonDown="SplitHalf_PreviewMouseLeftButtonDown"
                                        PreviewMouseDown="SplitHalf_PreviewMouseDown">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Right.IsActive}" Value="True">
                                                    <Setter Property="Background" Value="#44FFFFFF" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{Binding Right.Icon}" Width="16" Height="16" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding Right.Title}" Foreground="White" VerticalAlignment="Center" MaxWidth="120" TextTrimming="CharacterEllipsis" />
                                        <Button Content="×" Tag="RIGHT" Width="18" Height="18" Margin="6,-1,0,0"
                                                Padding="0" Background="Transparent" Foreground="#CCFFFFFF"
                                                BorderThickness="0" FontSize="14" ToolTip="Pop out right window"
                                                AutomationProperties.AutomationId="SplitCloseRight"
                                                PreviewMouseLeftButtonDown="SplitHalfClose_PreviewMouseLeftButtonDown"
                                                WindowChrome.IsHitTestVisibleInChrome="True" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.Resources>
            </ListBox>
        </Border>

        <!-- Inline capture surface. It is part of the container visual tree,
             rather than another Popup/Window, so routine capture does not add a
             competing top-level TabDock HWND. -->
        <Border Grid.Row="2" x:Name="CapturePanel" Visibility="Collapsed"
                Background="#F2181818" BorderBrush="#55FFFFFF" BorderThickness="0,1,0,1"
                Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="Add application" Foreground="White" FontWeight="SemiBold" />
                    <Button DockPanel.Dock="Right" Content="Refresh" Width="72" Height="24"
                            AutomationProperties.AutomationId="CaptureRefresh"
                            Command="{Binding RefreshCommand}" />
                </DockPanel>
                <ListBox Grid.Row="1" ItemsSource="{Binding Windows}" MaxHeight="190"
                         Background="#22FFFFFF" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Foreground="White" Padding="4">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" MaxWidth="420" />
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Content="Add selected" Width="96" Height="28" Margin="0,0,8,0"
                            AutomationProperties.AutomationId="CaptureAddSelected"
                            Command="{Binding GroupSelectedCommand}" />
                    <Button Content="Cancel" Width="72" Height="28"
                            AutomationProperties.AutomationId="CaptureCancel"
                            Command="{Binding CancelCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content area marker: a plain native HWND sized to exactly this
             region so both production code and the test harness can find
             "where is the docked position" the same way. Nothing is ever
             reparented into it — the active guest is a sibling top-level
             window positioned/shown/hidden to match (see
             ContainerWindow.xaml.cs's Shepherd active-tab sync). -->
        <Border Grid.Row="3" Background="#FF1E1E1E" x:Name="ContentBorder">
            <infra:NativeHwndHost x:Name="ContentHost" />
        </Border>
    </Grid>
</Window>
