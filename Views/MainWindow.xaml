<Window x:Class="TabDock.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="TabDock"
        Height="640"
        Width="900"
        MinWidth="620"
        MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource TdWindowBackgroundBrush}"
        Foreground="{StaticResource TdTextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid Margin="24,22,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="2,0,2,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Border Width="38" Height="38" CornerRadius="8"
                        Background="{StaticResource TdAccentSoftBrush}"
                        BorderBrush="{StaticResource TdAccentBrush}"
                        BorderThickness="1" Margin="0,0,12,0">
                    <Grid>
                        <Border Width="12" Height="12" CornerRadius="3"
                                Background="{StaticResource TdAccentBrush}"
                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                Margin="8,8,0,0" />
                        <Border Width="12" Height="12" CornerRadius="3"
                                Background="{StaticResource TdAccentTextBrush}"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Margin="0,0,8,8" />
                    </Grid>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="TabDock" Style="{StaticResource TdHeading}" />
                    <TextBlock Text="Desktop workspaces for the apps you already use."
                               Style="{StaticResource TdBodyMuted}"
                               Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>

            <Border Grid.Column="1" Style="{StaticResource TdBadge}"
                    VerticalAlignment="Center">
                <TextBlock Text="WORKSPACE MANAGER"
                           Style="{StaticResource TdSectionLabel}"
                           FontSize="10"
                           Foreground="{StaticResource TdTextSubtleBrush}" />
            </Border>
        </Grid>

        <Border Grid.Row="1" Margin="0,0,0,12" Padding="14,12"
                Background="{StaticResource TdWarningSurfaceBrush}"
                BorderBrush="{StaticResource TdWarningBorderBrush}" BorderThickness="1" CornerRadius="8"
                AutomationProperties.AutomationId="PendingRecoveryBanner"
                AutomationProperties.Name="{Binding PendingRecoveryBannerText}"
                AutomationProperties.LiveSetting="Assertive"
                AutomationProperties.HelpText="Inspect pending recovery from a terminal; native recovery is supervised and never automatic.">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasPendingRecoveryAttention}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="30" Height="30" CornerRadius="7"
                        Background="{StaticResource TdWarningIconSurfaceBrush}" BorderBrush="{StaticResource TdWarningBorderBrush}" BorderThickness="1"
                        Margin="0,0,12,0">
                    <TextBlock Text="!" Foreground="{StaticResource TdWarningBrush}"
                               FontWeight="Bold" FontSize="15"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding PendingRecoveryBannerText}"
                               Foreground="{StaticResource TdWarningBrush}"
                               FontWeight="SemiBold" FontSize="12"
                               AutomationProperties.AutomationId="PendingRecoverySummary" />
                    <WrapPanel Margin="0,5,0,0">
                        <TextBlock Text="Review: TabDock.exe --pending-recovery"
                                   Margin="0,0,18,0"
                                   Foreground="{StaticResource TdTextMutedBrush}"
                                   FontFamily="Cascadia Mono, Consolas" FontSize="10"
                                   AutomationProperties.AutomationId="PendingRecoveryInspectCommand" />
                        <TextBlock Text="Recover: TabDock.exe --recover-pending"
                                   Foreground="{StaticResource TdTextMutedBrush}"
                                   FontFamily="Cascadia Mono, Consolas" FontSize="10"
                                   AutomationProperties.AutomationId="PendingRecoveryRecoverCommand" />
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource TdCard}" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="2,0,2,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Workspaces" Style="{StaticResource TdSubheading}"
                                       VerticalAlignment="Center" />
                            <Border Style="{StaticResource TdBadge}" Margin="9,0,0,0"
                                    VerticalAlignment="Center" Padding="7,2">
                                <TextBlock Foreground="{StaticResource TdTextMutedBrush}" FontSize="10">
                                    <Run Text="{Binding Groups.Count, Mode=OneWay}" /><Run Text=" total" />
                                </TextBlock>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Open a workspace to bring its captured apps back together."
                                   Style="{StaticResource TdBodyMuted}"
                                   FontSize="11" Margin="0,3,12,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource TdSecondaryButton}"
                                Content="New workspace" MinWidth="120" Margin="0,0,8,0"
                                Command="{Binding NewGroupCommand}"
                                AutomationProperties.Name="Create a new workspace" />
                        <Button Style="{StaticResource TdPrimaryButton}"
                                MinWidth="210"
                                Command="{Binding CaptureCommand}"
                                IsEnabled="{Binding CaptureAllowed}"
                                AutomationProperties.AutomationId="LauncherCaptureButton"
                                AutomationProperties.Name="{Binding CaptureButtonText}"
                                AutomationProperties.HelpText="{Binding CaptureButtonToolTip}"
                                ToolTip="{Binding CaptureButtonToolTip}">
                            <TextBlock Text="{Binding CaptureButtonText}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       MaxWidth="198" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <ListView x:Name="GroupsListView"
                              ItemsSource="{Binding Groups}"
                              SelectedItem="{Binding SelectedGroup}"
                              AutomationProperties.Name="Workspaces"
                              AutomationProperties.HelpText="Select a workspace, then press Enter or double-click to open it."
                              BorderThickness="0"
                              Background="Transparent"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource TdListItem}">
                                <Setter Property="Padding" Value="13,11" />
                                <Setter Property="AutomationProperties.Name" Value="{Binding Name, StringFormat='Workspace {0}'}" />
                                <Setter Property="AutomationProperties.HelpText" Value="Press Enter or double-click to open this workspace." />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="4" Height="38" CornerRadius="2"
                                            Background="{Binding AccentColor, Converter={StaticResource ColorToBrushConverter}}"
                                            Margin="0,0,12,0" />

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TdTextBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Margin="0,3,0,0" FontSize="11"
                                                   Foreground="{StaticResource TdTextMutedBrush}">
                                            <Run Text="{Binding Members.Count, Mode=OneWay}" /><Run Text=" captured windows" />
                                        </TextBlock>
                                    </StackPanel>

                                    <Button Grid.Column="2" Style="{StaticResource TdToolbarButton}"
                                            Content="Open" MinWidth="62" Margin="14,0,0,0"
                                            Command="{Binding DataContext.OpenSelectedGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="{Binding Name, StringFormat='Open {0} workspace'}"
                                            ToolTip="Open this workspace" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                MaxWidth="390">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Groups.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Border Width="44" Height="44" CornerRadius="8"
                                Background="{StaticResource TdAccentSoftBrush}"
                                BorderBrush="{StaticResource TdBorderStrongBrush}"
                                BorderThickness="1"
                                HorizontalAlignment="Center" Margin="0,0,0,11">
                            <TextBlock Text="+" Foreground="{StaticResource TdAccentTextBrush}"
                                       FontSize="24" FontWeight="Light"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Build your first workspace"
                                   Style="{StaticResource TdSubheading}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Create an empty workspace or capture the windows already open on your desktop."
                                   Style="{StaticResource TdBodyMuted}"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   Margin="0,5,0,13" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Style="{StaticResource TdSecondaryButton}"
                                    Content="New workspace" MinWidth="118"
                                    Command="{Binding NewGroupCommand}"
                                    AutomationProperties.Name="Create first workspace" />
                            <Button Style="{StaticResource TdPrimaryButton}"
                                    Content="Capture windows" MinWidth="132" Margin="8,0,0,0"
                                    Command="{Binding CaptureCommand}"
                                    IsEnabled="{Binding CaptureAllowed}"
                                    AutomationProperties.Name="Capture windows for first workspace"
                                    ToolTip="{Binding CaptureButtonToolTip}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="2,12,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="{Binding CaptureAdmissionReason}"
                           Foreground="{StaticResource TdWarningBrush}"
                           TextWrapping="Wrap" FontSize="11"
                           AutomationProperties.AutomationId="CaptureAdmissionStatus"
                           AutomationProperties.LiveSetting="Polite">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CaptureAdmissionBlocked}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding TabNavigationAvailabilityText}"
                           Foreground="{StaticResource TdTextSubtleBrush}" FontSize="10"
                           Margin="0,2,0,0"
                           AutomationProperties.AutomationId="TabNavigationAvailability" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource TdGhostButton}"
                    Content="Exit TabDock" Padding="10,5" MinHeight="30"
                    Command="{Binding ExitCommand}"
                    AutomationProperties.Name="Exit TabDock" />
        </Grid>
    </Grid>
</Window>
