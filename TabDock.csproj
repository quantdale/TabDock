<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>TabDock</AssemblyName>
    <RootNamespace>TabDock</RootNamespace>
    <Version>1.0.0</Version>
    <IncludeSourceRevisionInInformationalVersion>true</IncludeSourceRevisionInInformationalVersion>
    <!-- Local/offline development may opt out of the network-backed audit. CI
         explicitly overrides this property to true and uses AuditMode=all;
         command-line properties take precedence over this local default. -->
    <NuGetAudit Condition="'$(NuGetAudit)' == ''">false</NuGetAudit>
    <!--
      The repository root also contains test projects and documentation. Exclude their build
      artifacts and source trees from the main WPF project so SDK default globs don't pull them in.
    -->
    <DefaultItemExcludes>$(DefaultItemExcludes);bin/**;obj/**;tests/**;docs/**</DefaultItemExcludes>

    <!--
      Native AOT is not practical for WPF: WPF relies on COM activation, reflection emit,
      and other runtime features that are incompatible with trimming/AOT.
      We therefore publish a self-contained single-file executable instead.
    -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishReadyToRun>true</PublishReadyToRun>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <!-- These generated attributes are consumed by BuildIdentity. They are
       build metadata, not a second source of truth, and intentionally contain
       no timestamp so deterministic source rebuilds remain comparable. -->
  <ItemGroup>
    <AssemblyMetadata Include="BuildConfiguration" Value="$(Configuration)" />
    <AssemblyMetadata Include="RuntimeIdentifier" Value="$(RuntimeIdentifier)" />
    <AssemblyMetadata Include="SelfContained" Value="$(SelfContained)" />
    <AssemblyMetadata Include="SourceRevisionId" Value="$(SourceRevisionId)" Condition="'$(SourceRevisionId)' != ''" />
  </ItemGroup>

  <ItemGroup>
    <!-- Stable .NET 8 ACL support for the secured Global product-mutation
         mutex. This package is Microsoft-maintained and has no net8.0
         transitive dependencies. -->
    <PackageReference Include="System.Threading.AccessControl" Version="10.0.11" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

</Project>
