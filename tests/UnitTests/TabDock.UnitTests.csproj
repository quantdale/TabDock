<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <DefineConstants>$(DefineConstants);TABDOCK_UNIT_TESTS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <ProjectReference Include="..\..\TabDock.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\ValidationDriver\fixtures\native-replay\*.json"
          Link="fixtures\native-replay\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="..\ValidationDriver\TabDock.ValidationDriver\ResourceStability.cs"
             Link="ValidationDriver\ResourceStability.cs" />
    <Compile Include="..\ValidationDriver\TabDock.ValidationDriver\ResourceLifecycleProfiles.cs"
             Link="ValidationDriver\ResourceLifecycleProfiles.cs" />
    <Compile Include="..\ValidationDriver\TabDock.ValidationDriver\ResourceStabilityArtifact.cs"
             Link="ValidationDriver\ResourceStabilityArtifact.cs" />
    <Compile Include="..\ValidationDriver\TabDock.ValidationDriver\Pixels.cs"
             Link="ValidationDriver\Pixels.cs" />
    <Compile Include="..\ValidationDriver\TabDock.ValidationDriver\VisualEvidenceModel.cs"
             Link="ValidationDriver\VisualEvidenceModel.cs" />
    <Compile Include="..\ValidationDriver\TabDock.ValidationDriver\PhysicalTopologyContracts.cs"
             Link="ValidationDriver\PhysicalTopologyContracts.cs" />
    <Compile Include="..\ValidationDriver\TabDock.ValidationDriver\VisualPathPolicy.cs"
             Link="ValidationDriver\VisualPathPolicy.cs" />
    <Compile Include="..\ValidationDriver\TabDock.ValidationDriver\VisualPngArtifacts.cs"
             Link="ValidationDriver\VisualPngArtifacts.cs" />
    <Compile Include="..\ValidationDriver\TabDock.ValidationDriver\VisualCaptureScopes.cs"
             Link="ValidationDriver\VisualCaptureScopes.cs" />
    <Compile Include="..\ValidationDriver\TabDock.ValidationDriver\VisualEvidenceRecorder.cs"
             Link="ValidationDriver\VisualEvidenceRecorder.cs" />
    <Compile Include="..\ValidationDriver\TabDock.ValidationDriver\VisualRingBuffer.cs"
             Link="ValidationDriver\VisualRingBuffer.cs" />
    <Compile Include="..\ValidationDriver\TabDock.ValidationDriver\VisualContactSheets.cs"
             Link="ValidationDriver\VisualContactSheets.cs" />
    <Compile Include="..\ValidationDriver\TabDock.ValidationDriver\VisualReviewPackets.cs"
             Link="ValidationDriver\VisualReviewPackets.cs" />
    <Compile Include="..\ValidationDriver\TabDock.ValidationDriver\VisualReviewVerifier.cs"
             Link="ValidationDriver\VisualReviewVerifier.cs" />
    <Compile Include="..\ValidationDriver\TabDock.ValidationDriver\ScenarioOutcome.cs"
             Link="ValidationDriver\ScenarioOutcome.cs" />
    <Compile Include="..\ValidationDriver\TabDock.ValidationDriver\VisualQualificationGate.cs"
             Link="ValidationDriver\VisualQualificationGate.cs" />
    <Compile Include="..\ValidationDriver\TabDock.ValidationDriver\VisualMeasurement.cs"
             Link="ValidationDriver\VisualMeasurement.cs" />
    <Compile Include="..\ValidationDriver\TabDock.ValidationDriver\VisualMeasurementRunner.cs"
             Link="ValidationDriver\VisualMeasurementRunner.cs" />
  </ItemGroup>

</Project>
